# =============================================================================
# DIGITAL BAZAR - PRODUCTION REAL ENV TEMPLATE
# Fill with REAL keys and set in Vercel / production server
# NEVER commit this file. Copy to .env.local or set in Vercel dashboard.
# See REAL_SETUP_GUIDE.md for step-by-step A to Z
# =============================================================================

# --- CORE - REQUIRED ---
# Database: Postgres for production (Neon/Supabase/Railway/Render)
# Example: postgresql://user:password@host:5432/digital_bazar?sslmode=require
# For local dev with docker-compose: postgresql://digital_bazar:digital_bazar_dev_password@localhost:5432/digital_bazar
DATABASE_URL="postgresql://digital_bazar:digital_bazar_dev_password@localhost:5432/digital_bazar"

# JWT: 32+ chars, generate via: openssl rand -hex 32
# CRITICAL: Used for auth + QR HMAC, must be 32+ chars, keep secret
JWT_SECRET="REPLACE_WITH_openssl_rand_-hex_32_OUTPUT_32_PLUS_CHARS"

# App URL: your deployed URL, must be https in prod for secure cookies
NEXT_PUBLIC_APP_URL="https://digital-bazar-three.vercel.app"

# Node env
NODE_ENV="production"

# Hide demo creds in prod
NEXT_PUBLIC_SHOW_DEMO_CREDS="false"

# --- AUTH - OTP REAL SMS ---
# Set false in prod to force real SMS, not hardcoded 123456
OTP_ENABLED="false"
OTP_TEST_CODE="123456"
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="3"
OTP_RESEND_COOLDOWN_SECONDS="60"

# SMS Provider: msg91 | fast2sms | twilio
SMS_PROVIDER="msg91"
SMS_API_KEY="REPLACE_WITH_REAL_MSG91_API_KEY"
SMS_SENDER_ID="DBAZAR"
SMS_TEMPLATE_ID="REPLACE_WITH_DLT_TEMPLATE_ID"
# Twilio alternative
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- PAYMENTS - Razorpay REAL ---
# Get from https://dashboard.razorpay.com/app/keys
# Test: rzp_test_xxx | Live: rzp_live_xxx
RAZORPAY_KEY_ID="rzp_live_REPLACE_WITH_REAL_LIVE_KEY"
RAZORPAY_KEY_SECRET="REPLACE_WITH_REAL_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_REAL_WEBHOOK_SECRET_32CHARS"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_REPLACE_WITH_REAL_LIVE_KEY"
PAYMENT_RECONCILIATION_ENABLED="true"
PAYMENT_RECONCILIATION_INTERVAL_MINUTES="15"

# --- AI - OpenAI REAL (optional, fallback rule-based if empty) ---
OPENAI_API_KEY="sk-proj-REPLACE_WITH_REAL_OPENAI_KEY"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_ORG_ID=""
AI_MAX_TOKENS="1000"
AI_TEMPERATURE="0.3"

# --- MAPS - Google Maps REAL (optional, haversine fallback) ---
MAPS_PROVIDER="google"
MAPS_API_KEY="REPLACE_WITH_REAL_GOOGLE_MAPS_KEY"
NEXT_PUBLIC_MAPS_API_KEY="REPLACE_WITH_REAL_GOOGLE_MAPS_KEY"

# --- EMAIL - Resend/SendGrid REAL (optional, in-app fallback) ---
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="re_REPLACE_WITH_REAL_RESEND_KEY"
EMAIL_FROM="Digital Bazar <noreply@yourdomain.com>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS=""
SMTP_SECURE="false"

# --- STORAGE - S3/R2 REAL (local only for dev, NEVER prod) ---
# For prod: use s3 or r2, local will lose files on Vercel
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="digital-bazar-products"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY="REPLACE_WITH_REAL_S3_ACCESS_KEY"
STORAGE_SECRET_KEY="REPLACE_WITH_REAL_S3_SECRET_KEY"
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""
STORAGE_MAX_FILE_SIZE_MB="5"
STORAGE_ALLOWED_TYPES="image/jpeg,image/png,image/webp"

# --- PUSH - VAPID REAL ---
# Generate via: npx web-push generate-vapid-keys
PUSH_PROVIDER="web-push"
VAPID_PUBLIC_KEY="REPLACE_WITH_REAL_VAPID_PUBLIC"
VAPID_PRIVATE_KEY="REPLACE_WITH_REAL_VAPID_PRIVATE"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# --- REALTIME - SSE built-in, or Pusher/Ably for scale ---
REALTIME_PROVIDER="sse"
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"
ABLY_API_KEY=""

# --- RATE LIMITING - Upstash Redis REAL for prod multi-instance ---
RATE_LIMIT_PROVIDER="upstash"
UPSTASH_REDIS_REST_URL="https://REPLACE_WITH_REAL_UPSTASH_URL"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_REAL_UPSTASH_TOKEN"
REDIS_URL="redis://localhost:6379"

# --- FEATURE FLAGS ---
FEATURE_AI_ASSISTANT="true"
FEATURE_IMAGE_SEARCH="true"
FEATURE_VOICE_SHOPPING="true"
FEATURE_ONLINE_PAYMENT="true"
FEATURE_DELIVERY="false"
FEATURE_PUSH_NOTIFICATIONS="false"
FEATURE_REVIEWS="true"
FEATURE_PROMOTIONS="true"
FEATURE_INVENTORY_FORECAST="true"
FEATURE_BUSINESS_HOURS="true"

# --- PLATFORM RULES ---
PLATFORM_COMMISSION_DEFAULT="5"
PLATFORM_MAX_ACTIVE_ORDERS="50"
PLATFORM_PREP_TIME_DEFAULT_MIN="15"
PLATFORM_LOW_STOCK_THRESHOLD="10"
PLATFORM_QR_EXPIRY_MINUTES="15"
PLATFORM_QR_SECRET=""
PLATFORM_TIMEZONE_DEFAULT="Asia/Kolkata"
PLATFORM_CURRENCY="INR"
PLATFORM_CURRENCY_MINOR_UNIT="100"

# --- OBSERVABILITY ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0.1"
LOG_LEVEL="info"
LOG_SANITIZE="true"

# --- SECURITY ---
BCRYPT_ROUNDS="12"
CORS_ALLOWED_ORIGINS="https://digital-bazar-three.vercel.app,https://yourdomain.com"
COOKIE_SECURE="true"
COOKIE_SAME_SITE="lax"
UPLOAD_MAX_SIZE_MB="5"
UPLOAD_ALLOWED_MIMES="image/jpeg,image/png,image/webp"

# --- JOBS ---
JOBS_PROVIDER="memory"
JOBS_REDIS_URL="redis://localhost:6379"

# --- SEO / PWA ---
NEXT_PUBLIC_SITE_NAME="Digital Bazar"
NEXT_PUBLIC_SITE_TAGLINE="Shop Local. Skip the Wait."
NEXT_PUBLIC_SITE_DESCRIPTION="Know it is in stock before you leave the house. Real inventory from nearby shops."
SEO_CANONICAL_URL="https://digital-bazar-three.vercel.app"
PWA_ENABLED="true"

# --- ADMIN ---
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_STRONG_32CHAR_PASSWORD"
