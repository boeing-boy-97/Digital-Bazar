# =============================================================================
# DIGITAL BAZAR - REAL PRODUCTION ENVIRONMENT (A to Z, No Fake)
# Copy this to .env and fill with REAL keys. See comments for how to get each.
# Never commit .env to git. This file is template only.
# =============================================================================

# --- CORE ---
# Database: SQLite for dev, Postgres for prod (Neon/Supabase/Railway)
# Dev:  file:./dev.db
# Prod: postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL="file:./dev.db"

# JWT: 32+ chars, generate: openssl rand -hex 32
# CRITICAL: Must be 32+ chars in production, same secret used for QR HMAC
JWT_SECRET="change-this-super-secret-jwt-key-min-32-chars-long-please"

# App URL: your deployed URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# For prod: https://yourdomain.com

# Node env: development | production | test
NODE_ENV="development"

# Show demo credentials in login UI? ONLY dev, NEVER production
NEXT_PUBLIC_SHOW_DEMO_CREDS="true"

# =============================================================================
# AUTH - OTP (Real SMS, No Hardcoded 123456 in Prod)
# =============================================================================
# Test mode: ONLY non-production. Set false in prod to force real OTP
OTP_ENABLED="false"
# Test code: ONLY dev, ignored in production (lib/auth/jwt checks NODE_ENV)
OTP_TEST_CODE="123456"
# OTP settings
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="3"
OTP_RESEND_COOLDOWN_SECONDS="60"

# SMS Provider for REAL OTP: msg91 | fast2sms | twilio | custom
SMS_PROVIDER="msg91"
SMS_API_KEY="your_msg91_or_fast2sms_api_key"
SMS_SENDER_ID="DBAZAR"
SMS_TEMPLATE_ID="your_dlt_template_id_for_otp"
# Twilio alternative (if using twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# =============================================================================
# PAYMENTS - Razorpay (Real, No Mock in Prod)
# How to get: https://dashboard.razorpay.com/app/keys
# Test keys: rzp_test_xxx | Live keys: rzp_live_xxx
# Webhook secret: Dashboard > Settings > Webhooks > Secret
# =============================================================================
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_real"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_real_random_32chars"
# Public key must match KEY_ID for frontend
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxx"

# Razorpay mode: auto-detected via KEY_ID contains 'test' or 'live'
# In test mode, service returns mock order_mock_*. In prod, uses real SDK.
# To enable real SDK, install razorpay: npm i razorpay and uncomment real call in lib/payments/razorpay.ts
# For prod, you MUST set live keys and set NODE_ENV=production

# Payment reconciliation: how often to check payment captured but order pending (cron)
PAYMENT_RECONCILIATION_ENABLED="true"
PAYMENT_RECONCILIATION_INTERVAL_MINUTES="15"

# =============================================================================
# AI - OpenAI (Real, Fallback Rule-Based if Missing)
# How to get: https://platform.openai.com/api-keys
# =============================================================================
OPENAI_API_KEY="sk-proj-xxx_real_key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_ORG_ID=""
# AI safety: never invent price/stock, must call backend tools
AI_MAX_TOKENS="1000"
AI_TEMPERATURE="0.3"

# =============================================================================
# MAPS - Distance, Shop Discovery (Real)
# Google Maps: https://console.cloud.google.com/apis/credentials
# Or Mapbox: https://account.mapbox.com/access-tokens
# =============================================================================
MAPS_PROVIDER="google" # google | mapbox | none
MAPS_API_KEY="your_google_maps_api_key"
NEXT_PUBLIC_MAPS_API_KEY="your_google_maps_public_key_same_as_MAPS_API_KEY"
# For distance calc, we use haversine (no API needed), but for places autocomplete need Maps API

# =============================================================================
# EMAIL - Real Transactional (Resend/SendGrid/SMTP)
# Resend: https://resend.com/api-keys
# SendGrid: https://app.sendgrid.com/settings/api_keys
# =============================================================================
EMAIL_PROVIDER="resend" # resend | sendgrid | smtp | none
EMAIL_API_KEY="re_xxx_real_resend_key"
EMAIL_FROM="Digital Bazar <noreply@yourdomain.com>"
# SMTP alternative
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="your_smtp_pass"
SMTP_SECURE="false"

# =============================================================================
# STORAGE - Product Images (Real S3/R2, Local for Dev)
# Local: files saved to public/uploads (dev only)
# S3: AWS S3, R2: Cloudflare R2 (S3 compatible)
# How to get: AWS IAM or Cloudflare R2 dashboard
# =============================================================================
STORAGE_PROVIDER="local" # local | s3 | r2
STORAGE_BUCKET="digital-bazar-products"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY="your_s3_access_key"
STORAGE_SECRET_KEY="your_s3_secret_key"
STORAGE_ENDPOINT="" # For R2: https://<account>.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL="" # For R2: https://pub-xxx.r2.dev or custom domain
STORAGE_MAX_FILE_SIZE_MB="5"
STORAGE_ALLOWED_TYPES="image/jpeg,image/png,image/webp"

# =============================================================================
# PUSH NOTIFICATIONS - Real Web Push (VAPID)
# Generate: npx web-push generate-vapid-keys
# https://www.npmjs.com/package/web-push
# =============================================================================
PUSH_PROVIDER="web-push" # web-push | firebase | none
VAPID_PUBLIC_KEY="your_vapid_public_key_base64"
VAPID_PRIVATE_KEY="your_vapid_private_key_base64"
VAPID_SUBJECT="mailto:admin@yourdomain.com"
# Firebase alternative
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# =============================================================================
# REALTIME - SSE (Built-in) or Pusher/Ably for Prod Scale
# SSE is built-in, no env needed for dev. For prod scale, use Pusher/Ably
# =============================================================================
REALTIME_PROVIDER="sse" # sse | pusher | ably
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"
ABLY_API_KEY=""

# =============================================================================
# RATE LIMITING - Real Redis for Prod (Upstash)
# Dev uses in-memory Map. Prod MUST use Redis to survive multi-instance.
# Upstash: https://console.upstash.com/redis
# =============================================================================
RATE_LIMIT_PROVIDER="memory" # memory | upstash | redis
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"
REDIS_URL="redis://localhost:6379"

# Rate limit configs (optional overrides, defaults in lib/rate-limit/simple.ts)
RATE_LIMIT_AUTH_MAX="20"
RATE_LIMIT_AUTH_WINDOW_MIN="15"
RATE_LIMIT_OTP_MAX="3"
RATE_LIMIT_OTP_WINDOW_MIN="1"
RATE_LIMIT_CHECKOUT_MAX="5"
RATE_LIMIT_PAYMENT_MAX="10"

# =============================================================================
# FEATURE FLAGS - Turn Real Features On/Off
# =============================================================================
FEATURE_AI_ASSISTANT="true"
FEATURE_IMAGE_SEARCH="true"
FEATURE_VOICE_SHOPPING="true"
FEATURE_ONLINE_PAYMENT="true"
FEATURE_DELIVERY="false"
FEATURE_PUSH_NOTIFICATIONS="false"
FEATURE_REVIEWS="true"
FEATURE_PROMOTIONS="true"
FEATURE_INVENTORY_FORECAST="true"
FEATURE_BUSINESS_HOURS="true"

# =============================================================================
# PLATFORM - Real Business Rules
# =============================================================================
PLATFORM_COMMISSION_DEFAULT="5" # 5%
PLATFORM_MAX_ACTIVE_ORDERS="50" # Shop capacity per point 32
PLATFORM_PREP_TIME_DEFAULT_MIN="15"
PLATFORM_LOW_STOCK_THRESHOLD="10"
PLATFORM_QR_EXPIRY_MINUTES="15"
PLATFORM_QR_SECRET="" # Uses JWT_SECRET if empty, but can be separate for rotation
PLATFORM_TIMEZONE_DEFAULT="Asia/Kolkata"
PLATFORM_CURRENCY="INR"
PLATFORM_CURRENCY_MINOR_UNIT="100" # 1 INR = 100 paise

# Business hours: structured Mon-Sun, supports overnight, multiple intervals
# See ShopBusinessHours model: dayOfWeek 0=Sun, openTime HH:MM, closeTime HH:MM, isClosed, isOvernight

# =============================================================================
# OBSERVABILITY - Real Monitoring (Sentry)
# Sentry: https://sentry.io/settings/projects/.../keys/
# =============================================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Logging: structured JSON with requestId correlation
LOG_LEVEL="info" # debug | info | warn | error
LOG_SANITIZE="true" # Redact passwords, OTP, secrets

# =============================================================================
# SECURITY - Real Secrets
# =============================================================================
# Password hashing: bcrypt rounds
BCRYPT_ROUNDS="12"

# CORS: allowed origins for API
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Cookie: secure in prod
COOKIE_SECURE="true"
COOKIE_SAME_SITE="lax"

# File upload: real validation per lib/storage/validation.ts
UPLOAD_MAX_SIZE_MB="5"
UPLOAD_ALLOWED_MIMES="image/jpeg,image/png,image/webp"

# =============================================================================
# JOBS - Background Queue (Real Redis/BullMQ for Prod)
# Dev uses in-memory jobQueue. Prod should use BullMQ + Redis
# =============================================================================
JOBS_PROVIDER="memory" # memory | bullmq
JOBS_REDIS_URL="redis://localhost:6379"

# =============================================================================
# SEO / PWA
# =============================================================================
NEXT_PUBLIC_SITE_NAME="Digital Bazar"
NEXT_PUBLIC_SITE_TAGLINE="Shop Local. Skip the Wait."
NEXT_PUBLIC_SITE_DESCRIPTION="Know it is in stock before you leave the house. Real inventory from nearby shops."
SEO_CANONICAL_URL="https://yourdomain.com"
PWA_ENABLED="true"

# =============================================================================
# ADMIN
# =============================================================================
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="change_me_immediately_32chars"

# =============================================================================
# HOW TO MAKE REAL - QUICK CHECKLIST (No Fake)
# =============================================================================
# 1. DATABASE: Create Postgres at Neon (neon.tech) or Supabase, copy URL to DATABASE_URL
# 2. JWT: openssl rand -hex 32 -> JWT_SECRET (32+ chars)
# 3. RAZORPAY: Create account, get live keys rzp_live_*, webhook secret, set in env, install razorpay SDK
# 4. SMS OTP: Sign up MSG91/Fast2SMS, get API key, DLT template ID, set SMS_API_KEY, set OTP_ENABLED=false
# 5. EMAIL: Sign up Resend, get API key, verify domain, set EMAIL_API_KEY + EMAIL_FROM
# 6. STORAGE: Create S3 bucket or R2 bucket, get access keys, set STORAGE_* to s3/r2, not local in prod
# 7. MAPS: Enable Google Maps JS + Places + Distance Matrix, get API key, restrict to domain, set MAPS_API_KEY
# 8. AI: Get OpenAI key, set OPENAI_API_KEY, or keep empty for rule-based fallback (honest)
# 9. PUSH: npx web-push generate-vapid-keys, set VAPID_* keys
# 10. REDIS: Create Upstash Redis, set UPSTASH_* for rate limiting prod, not in-memory
# 11. APP URL: Set NEXT_PUBLIC_APP_URL to your Vercel/domain URL https://...
# 12. PROD CHECK: Set NODE_ENV=production, NEXT_PUBLIC_SHOW_DEMO_CREDS=false, OTP_ENABLED=false, STORAGE_PROVIDER=s3/r2
# 13. VERIFY: Run npm run build, check no demo keys, no 123456, no mock payments in prod logs
# 14. DEPLOY: Vercel env vars, add all real keys, deploy, test real flow: register -> search -> add -> checkout -> Razorpay live -> QR -> complete -> invoice
# =============================================================================
# NEVER: Commit .env, use hardcoded 123456 in prod, use demo Razorpay keys in prod, use local storage in prod, fake analytics/shop counts
# ALWAYS: Server authoritative price (paise), transactional inventory, HMAC QR single-use, webhook signature verify, audit logs, requestId correlation
# =============================================================================
